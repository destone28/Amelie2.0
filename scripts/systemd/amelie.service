[Unit]
Description=Amelie - applicazione
After=network.target amelie-audio-guard.service
# Il modello linguistico NON si tira su da qui: lo accende e lo spegne
# l'applicazione col modo di racconto, perche' fermo a vuoto costa un core
# intero - misurato, 88% - e quel core serve all'OCR. Vedi
# `Amelie._accendi_il_modello`.

[Service]
Type=simple
User=arduino
WorkingDirectory=/home/arduino/amelie
Environment=PYTHONPATH=/home/arduino/amelie/src
Environment=PYTHONUNBUFFERED=1
# Com'e' installato: il modello e' disponibile (lo accende il modo
# «generativa»), e' quello addestrato su questo progetto, e la carta dei vini
# sta accanto al codice. Senza `--con-modello` il modo «generativa» non si
# puo' scegliere e un modo salvato torna in silenzio all'archivio: e'
# successo reinstallando questo file.
ExecStart=/home/arduino/amelie/venv/bin/python -m amelie.app --porta 8080 \
    --con-modello --modello-addestrato --carta /home/arduino/amelie/vini.csv
Restart=always
RestartSec=5
# Un Amelie che non parte e' peggio di un Amelie muto: se il modello o l'MCU
# mancano, l'applicazione deve avviarsi lo stesso e dirlo sulla pagina di stato.
MemoryMax=900M

# Confinamento. Il dispositivo sta su un tavolo di ristorante, con porte USB
# raggiungibili: se qualcuno arriva a una shell, questi limiti riducono cosa
# puo' fare. ProtectSystem=strict rende /usr e /etc di sola lettura, e si apre
# in scrittura solo cio' che serve davvero.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
ReadWritePaths=/home/arduino/.cache /home/arduino/amelie/var

[Install]
WantedBy=multi-user.target
