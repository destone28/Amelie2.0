[Unit]
Description=Amelie - schermo a tutto campo
After=amelie-display.service amelie.service
Requires=amelie-display.service

[Service]
Type=simple
User=arduino
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/arduino/.Xauthority
# Niente attesa: la schermata d'avvio e' un file e non ha bisogno del server.
# Ogni secondo speso qui e' un secondo in cui si vede qualcos'altro sullo schermo.
ExecStart=/usr/local/bin/amelie-kiosk.sh
Restart=always
RestartSec=8
# Chromium e' adattivo nel consumo: con un tetto si comporta da dispositivo
# piccolo invece di prendersi tutto cio' che trova.
MemoryHigh=420M
MemoryMax=520M

[Install]
WantedBy=graphical.target
