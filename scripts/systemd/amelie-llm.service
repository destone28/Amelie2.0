[Unit]
Description=Amelie - modello linguistico locale (llama.cpp)
After=network.target

[Service]
Type=simple
User=arduino
WorkingDirectory=/home/arduino/amelie
# Il modello e' lo studente affinato su questo progetto, non il modello di
# partenza. `studente-q4_k_m.gguf`, in models/, e' un nome fisso: una versione
# nuova prende lo stesso nome, e l'unita' non cambia a ogni riaddestramento.
#
# --cache-reuse permette di riusare il prefisso gia' elaborato fra una richiesta
# e l'altra. Su questa board e' la differenza fra usabile e inusabile: il
# prefill gira a ~8 token/s, quindi le istruzioni fisse costerebbero venti
# secondi a ogni bottiglia. Rilette una volta sola, costano zero.
ExecStart=/home/arduino/amelie/llama.cpp/build/bin/llama-server \
    --model /home/arduino/amelie/models/studente-q4_k_m.gguf \
    --host 127.0.0.1 --port 8081 \
    --threads 4 --ctx-size 2048 \
    --cache-reuse 256 \
    --no-webui
Restart=on-failure
RestartSec=10
# Lo spegnimento a vuoto e' istantaneo, ma se arriva mentre il modello sta
# scrivendo `llama-server` non risponde al SIGTERM finche' non ha finito, e con
# il minuto e mezzo di default systemd lo lascia in «deactivating» per tutto
# quel tempo - poi lo ammazza e l'unita' resta in stato «failed». Misurato: 90
# secondi in cui una richiesta di accensione resterebbe in coda.
#
# Quindici secondi bastano: non c'e' niente da salvare, il modello e' un file
# di sola lettura e il racconto in corso e' gia' perso comunque.
TimeoutStopSec=15
KillMode=mixed
# Lo studente in Q4_K_M occupa ~400 MB: il tetto lascia respiro a OCR, voce e interfaccia
# sui 3,6 GiB della board, e fa fallire il servizio invece di mandare tutto
# in swap su eMMC, che sarebbe molto peggio.
MemoryMax=1400M
Nice=5

# Confinamento. Il dispositivo sta su un tavolo di ristorante, con porte USB
# raggiungibili: se qualcuno arriva a una shell, questi limiti riducono cosa
# puo' fare. ProtectSystem=strict rende /usr e /etc di sola lettura, e si apre
# in scrittura solo cio' che serve davvero.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
ReadWritePaths=/home/arduino/.cache

[Install]
WantedBy=multi-user.target
